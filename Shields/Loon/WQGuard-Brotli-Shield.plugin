#!name = WQGuard · 防 Brotli 溢出降级护盾 (CVE-2026-111497)
#!desc = 针对 iOS 26.x 与 iOS 27.0–27.2.0 未修复之 libbrotli 堆越界写高危漏洞 (CVE-2026-111497 / HTTP2Shell)，强制降级 Accept-Encoding 为 gzip,deflate 并阻断恶意强推的 br 响应。内置 16 项负向排除，保障 Apple Intelligence、Siri 与支付正常使用。
#!openUrl = https://github.com/Kianuni/WQGuard
#!author = WQGuard Contributors
#!tag = 安全防护
#!system = iOS

[Argument]
EXTRA_MITM_HOSTS = input, "*.example.invalid", tag = 附加防护域名, desc = 可选补充需要开启 Brotli 降级保护的自定义域名后缀（如 *.cc, *.me）

[Rewrite]
^https?://.+ header-replace Accept-Encoding gzip,deflate

[Script]
http-response ^https?://.+ script-path=https://raw.githubusercontent.com/Kianuni/WQGuard/main/Shields/scripts/brotli-guard.js,requires-body=false,timeout=5,tag=WQGuard-Brotli-Guard

[Mitm]
hostname = -*.apple.com, -*.icloud.com, -*.icloud-content.com, -*.mzstatic.com, -*.cdn-apple.com, -guzzoni.apple.com, -*.siri.apple.com, -gspe1-ssl.ls.apple.com, -apple-relay.*, -cp4.cloudflare.com, -*.openai.com, -*.chatgpt.com, -*.binance.com, -*.okx.com, -*.tenpay.com, -*.alipay.com, *.xyz, *.top, *.icu, *.cyou, *.sbs, *.cfd, *.buzz, *.fun, *.click, *.link, *.site, *.online, *.shop, *.vip, *.pw, *.work, *.rest, *.monster, *.quest, *.zip, *.mov, {EXTRA_MITM_HOSTS}
